{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/*)",
      "Bash(node screens/tools/render.mjs *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint *)",
      "Bash(npx drizzle-kit check*)"
    ],
    "deny": [
      "Edit(/proposal/**)",
      "Write(/proposal/**)",
      "Edit(/screens/previews/**)",
      "Write(/screens/previews/**)",
      "Edit(/screens/canvas/ds/**)",
      "Write(/screens/canvas/ds/**)",
      "Read(/.env)",
      "Read(/app/.env)",
      "Read(/app/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"", "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/model-advisor.mjs\"", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.mjs\"", "timeout": 60 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-audit.mjs\"", "timeout": 120 }] }
    ]
  },
  "enabledMcpjsonServers": ["context7", "playwright", "next-devtools"],
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
