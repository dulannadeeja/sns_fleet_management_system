{
  "name": "sns-fleet-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "aws4fetch": "1.0.20",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "vitest run tests/messages.test.ts && next build",
    "prebuild": "node scripts/sync-plate.mjs",
    "check:plate": "node scripts/sync-plate.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test:down": "docker compose -f docker/compose.test.yml down",
    "db:test:up": "docker compose -f docker/compose.test.yml up -d --wait",
    "dev": "next dev",
    "predev": "node scripts/sync-plate.mjs",
    "lint": "eslint .",
    "prelint": "node scripts/sync-plate.mjs",
    "people:add": "node scripts/sync-plate.mjs && tsx --conditions=react-server --env-file-if-exists=.env.local scripts/people-add.ts",
    "start": "next start",
    "sync:plate": "node scripts/sync-plate.mjs",
    "test": "vitest run",
    "pretest": "node scripts/sync-plate.mjs",
    "test:at-coverage": "node scripts/at-coverage.mjs",
    "test:at-coverage:strict": "node scripts/at-coverage.mjs --strict",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/sync-plate.mjs && next typegen"
  }
}
