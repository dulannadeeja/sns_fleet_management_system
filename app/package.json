{
  "name": "sns-fleet-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "vitest run tests/messages.test.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:at-coverage": "node scripts/at-coverage.mjs",
    "test:at-coverage:strict": "node scripts/at-coverage.mjs --strict"
